# Copy to .env and fill in values. Never commit .env.

# Postgres — point at Railway for local MCP testing against prod-like data
DATABASE_URL=

# Shared Cognito API key — REST /api/cognito/* ONLY.
# No longer accepted by /mcp, which uses Google OAuth (below).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COGNITO_API_KEY=

# Google OAuth for the MCP server. Credentials come from the taums.ai OAuth
# client (1Password) — set these directly on Railway, don't paste them around.
# The client must have BOTH registered:
#   redirect URI:  https://tau-crm-production.up.railway.app/auth/redirect
#   JS origin:     https://tau-crm-production.up.railway.app
# Without these the MCP server serves no tools; the REST API is unaffected.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional — override the public base URL used to build OAuth callback URLs.
# Defaults to the Railway production host.
MCP_PUBLIC_BASE_URL=

# Optional — Cognito Grok chat
GROK_API_KEY=
