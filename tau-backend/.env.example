# Copy to .env and fill in values. Never commit .env.

# Postgres — point at Railway for local MCP testing against prod-like data
DATABASE_URL=

# Shared Cognito API key (REST /api/cognito/* and MCP /mcp)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COGNITO_API_KEY=

# Optional — Cognito Grok chat
GROK_API_KEY=
